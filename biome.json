{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "package.json",
      "pnpm-workspace.yaml",
      ".dependency-cruiser.mjs",
      "apps/**",
      "!apps/**/.convex",
      "!apps/**/dist",
      "!apps/**/external-garfex-boundary/client-facing/generated",
      "!apps/**/convex/_generated",
      ".github/**",
      "README.md",
      "docs/**",
      "tooling/**",
      "tsconfig*.json",
      "vitest.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
